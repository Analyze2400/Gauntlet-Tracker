rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == "ana1yze2400@gmail.com";
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidGameEntry(data) {
      return hasOnlyAllowedFields(['game', 'players', 'winCounts', 'timestamp']) &&
             data.game is string && data.game.size() > 0 && data.game.size() < 100 &&
             data.players is list && data.players.size() > 0 && data.players.size() < 20 &&
             data.timestamp is number;
    }

    function isValidPlayer(data) {
      return hasOnlyAllowedFields(['name', 'points', 'history']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 50 &&
             data.points is number && data.points >= 0 &&
             data.history is list && data.history.size() < 500;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /entries/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidGameEntry(request.resource.data);
      allow update: if false; // Entries are immutable
      allow delete: if isAdmin();
    }

    match /players/{playerName} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidPlayer(request.resource.data);
      allow update: if isAuthenticated() && isValidPlayer(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
